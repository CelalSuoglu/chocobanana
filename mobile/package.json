{
  "name": "chocobanana-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "iOS and Android shell for thechocobananaclub.com (Capacitor). The web app itself lives in the parent folder.",
  "scripts": {
    "setup": "npm install && node scripts/write-app-url.mjs && npx cap add ios && npx cap add android && npm run assets && npx cap sync",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#fffbee' --iconBackgroundColorDark '#fffbee' --splashBackgroundColor '#fff4cc' --splashBackgroundColorDark '#fff4cc'",
    "sync": "node scripts/write-app-url.mjs && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "run:ios": "npx cap run ios",
    "run:android": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5"
  }
}
