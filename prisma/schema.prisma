generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OWNER
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  NEW
  PREPARING
  SHIPPED
  COMPLETED
  CANCELED
}

enum MailClubSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  INCOMPLETE
  PAST_DUE
}

enum RewardCodeStatus {
  AVAILABLE
  RESERVED
  USED
  VOID
}

/// One row. Public pages are open only while server time is inside [startsAt, endsAt).
model PublicSiteOpening {
  id        String   @id
  startsAt  DateTime
  endsAt    DateTime
  updatedAt DateTime @updatedAt
}

model User {
  id                String    @id @default(cuid())
  name              String?
  firstName         String?
  lastName          String?
  email             String    @unique
  emailVerified     DateTime?
  passwordHash      String
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  postalCode        String?
  country           String?
  role              Role      @default(CUSTOMER)
  preferredLocale   String?   @default("en")
  image             String?
  stripeCustomerId  String?   @unique
  marketingOptIn    Boolean   @default(false)
  welcomeEmailSentAt DateTime?
  welcomeDiscountUsedAt DateTime?
  welcomeReservedSessionId String? @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  rewardCodes       RewardCode[]
  rewardRedemptions RewardCodeRedemption[]
  mailClubSubscriptions MailClubSubscription[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  pushDevices       PushDevice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  /** SHA-256 hex of the raw token. The raw value is only emailed once. */
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Hashed IP and email buckets for password-reset request limits. */
model PasswordResetAttempt {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model Order {
  id                     String            @id @default(cuid())
  /** Customer-facing code: 4 digits and 1 letter, for example 4821K. */
  publicNumber           String            @unique
  userId                 String?
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeCheckoutSessionId String           @unique
  stripePaymentIntentId  String?
  stripeSubscriptionId   String?
  stripeInvoiceId        String?           @unique
  billingReason          String?
  stripeEventIds         String[]          @default([])
  paymentStatus          PaymentStatus     @default(PAID)
  fulfillmentStatus      FulfillmentStatus @default(NEW)
  amountTotalCadCents    Int
  currency               String            @default("cad")
  shippingAmountCadCents Int?
  taxAmountCadCents      Int?
  discountAmountCadCents Int?
  presentmentAmountCents Int?
  presentmentCurrency    String?
  customerEmail          String
  customerName           String?
  customerPhone          String?
  shippingName           String?
  shippingLine1          String?
  shippingLine2          String?
  shippingCity           String?
  shippingState          String?
  shippingPostalCode     String?
  shippingCountry        String?
  locale                 String?
  confirmationEmailSentAt DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  items                  OrderItem[]
  rewardEarned           RewardCode?       @relation("RewardEarnedFrom")
  rewardRedemption       RewardCode?       @relation("RewardUsedOn")

  @@index([createdAt])
  @@index([fulfillmentStatus])
  @@index([customerEmail])
  @@index([userId])
  @@index([stripeSubscriptionId])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogProductId String
  name            String
  quantity        Int
  unitAmountCadCents Int
  currency        String @default("cad")
}

model MailClubSubscription {
  id                   String                     @id @default(cuid())
  userId               String
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String                     @unique
  status               MailClubSubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([userId])
  @@index([status])
}

model RewardCode {
  id                        String           @id @default(cuid())
  code                      String           @unique
  userId                    String
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** 5, 10, 15… qualifying paid orders. Manual gifts use 0. */
  milestone                 Int
  percentOff                Int              @default(10)
  /** Issued directly, not from the every-5-orders counter. */
  manual                    Boolean          @default(false)
  /** Any signed-in customer can use this code. Personal milestone codes stay false. */
  shared                    Boolean          @default(false)
  /** Shared codes that apply only when the customer has no paid order yet. */
  firstOrderOnly            Boolean          @default(false)
  status                    RewardCodeStatus @default(AVAILABLE)
  earnedFromOrderId         String?          @unique
  earnedFromOrder           Order?           @relation("RewardEarnedFrom", fields: [earnedFromOrderId], references: [id], onDelete: Restrict)
  stripePromotionCodeId     String?          @unique
  reservedCheckoutSessionId String?          @unique
  usedOnOrderId             String?          @unique
  usedOnOrder               Order?           @relation("RewardUsedOn", fields: [usedOnOrderId], references: [id], onDelete: SetNull)
  createdAt                 DateTime         @default(now())
  reservedAt                DateTime?
  usedAt                    DateTime?
  voidedAt                  DateTime?
  redemptions               RewardCodeRedemption[]

  @@unique([userId, milestone])
  @@index([userId, status])
}

/** One customer's use of a shared code. The parent code stays available for other accounts. */
model RewardCodeRedemption {
  id                        String           @id @default(cuid())
  rewardCodeId              String
  rewardCode                RewardCode       @relation(fields: [rewardCodeId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                    RewardCodeStatus @default(AVAILABLE)
  reservedCheckoutSessionId String?          @unique
  usedOnOrderId             String?          @unique
  reservedAt                DateTime?
  usedAt                    DateTime?

  @@unique([rewardCodeId, userId])
  @@index([rewardCodeId, status])
}

model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

enum MailingStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

/// Mailing-list signup. This is not a customer account.
model EmailSubscriber {
  id                     String        @id @default(cuid())
  email                  String        @unique
  firstName              String?
  marketingOptIn         Boolean       @default(false)
  status                 MailingStatus @default(PENDING)
  verificationTokenHash  String?       @unique
  unsubscribeTokenHash   String?       @unique
  verificationSentAt     DateTime?
  verifiedAt             DateTime?
  welcomeEmailSentAt     DateTime?
  unsubscribedAt         DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
}

/** A note sent from the public contact form. */
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum PushPlatform {
  IOS
  ANDROID
}

/// A phone that opted in to notifications in the iOS/Android app.
/// Tokens are only ever created after the member taps "Turn on notifications".
model PushDevice {
  id         String       @id @default(cuid())
  token      String       @unique
  platform   PushPlatform
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale     String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([userId])
}
