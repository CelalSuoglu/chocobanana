# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (Auth.js / NextAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for registration, email verification, and password reset.
# Both must be set. EMAIL_FROM must use a domain verified in Resend
# (Resend → Domains → DNS). Example: noreply@yourdomain.com
# Without these, register / forgot-password show “setup required” (no link logging).
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres — Neon, Vercel Postgres, etc.)
# ---------------------------------------------------------------------------
# Required for checkout — payment is not started if this is missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# One-time owner bootstrap secret (server only). Rotate after first owner.
# Bootstrap closes permanently once an OWNER exists.
OWNER_BOOTSTRAP_SECRET=

# Password for the /owner/gate form (never pass as a URL query).
OWNER_PANEL_SECRET=

# ---------------------------------------------------------------------------
# Coming soon gate (Production vs Preview)
# ---------------------------------------------------------------------------
# COMING_SOON_ENABLED — when "true", visitors only see the countdown page.
#   Recommended Vercel setup:
#     • Production  → COMING_SOON_ENABLED=true
#     • Preview     → leave unset / false (full shop, accounts, owner panel)
#     • Development → leave unset / false for local work
#   Open the site for everyone: set Production to false and redeploy.
#   The countdown never auto-unlocks at zero.
COMING_SOON_ENABLED=false

# COMING_SOON_ENDS_AT — fixed countdown end as ISO 8601 with timezone.
#   Example: COMING_SOON_ENDS_AT=2026-11-03T12:00:00-04:00
COMING_SOON_ENDS_AT=

# COMING_SOON_PREVIEW_SECRET — unlock via POST form at /site-unlock only
#   (never as ?preview= in the URL). Sets an httpOnly derived cookie.
COMING_SOON_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Stripe (test keys for local / Preview; never commit real secrets)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Set to "true" only after Adaptive Pricing is enabled in the Stripe Dashboard
STRIPE_ADAPTIVE_PRICING=false

# Live charges stay OFF unless both a live secret key AND this flag are set
PAYMENTS_LIVE_ENABLED=false
