# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Coming soon gate (Production vs Preview)
# ---------------------------------------------------------------------------
# COMING_SOON_ENABLED — when "true", visitors only see the countdown page.
#   All other routes redirect to the locale home, and public /api/checkout
#   returns 503. Recommended Vercel setup:
#     • Production  → COMING_SOON_ENABLED=true
#     • Preview     → leave unset / false (full shop for branch deploys)
#     • Development → leave unset / false for local work
#   Open the site for everyone after ~40 days: set Production to false
#   (or remove) and redeploy. The countdown never auto-unlocks at zero.
COMING_SOON_ENABLED=false

# COMING_SOON_ENDS_AT — fixed countdown end as ISO 8601 with timezone.
#   One absolute instant (not "now + 40 days" per visitor).
#   Example: COMING_SOON_ENDS_AT=2026-11-03T12:00:00-04:00
COMING_SOON_ENDS_AT=

# COMING_SOON_PREVIEW_SECRET — owner-only unlock while Production is gated.
#   Visit:  https://your-domain/?preview=YOUR_SECRET
#   That sets an httpOnly cookie so YOU can browse shop/cart/pages to edit
#   and check work. Everyone else still sees the countdown.
#   Lock again: https://your-domain/?preview=off
#   Keep this value private — do not share or commit it.
COMING_SOON_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Stripe (test keys for local / Preview; never commit real secrets)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Set to "true" only after Adaptive Pricing is enabled in the Stripe Dashboard
STRIPE_ADAPTIVE_PRICING=false

# Live charges stay OFF unless both a live secret key AND this flag are set
PAYMENTS_LIVE_ENABLED=false
