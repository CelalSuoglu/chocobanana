# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (Auth.js / NextAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for registration, email verification, and password reset.
# Both must be set. EMAIL_FROM must use a domain verified in Resend
# (Resend → Domains → DNS). Example: noreply@yourdomain.com
# Without these, register / forgot-password show “setup required” (no link logging).
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres — Neon, Vercel Postgres, etc.)
# ---------------------------------------------------------------------------
# Required for checkout — payment is not started if this is missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# One-time owner bootstrap secret (server only). Rotate after first owner.
# Bootstrap closes permanently once an OWNER exists.
OWNER_BOOTSTRAP_SECRET=

# Password for the /owner/gate form (never pass as a URL query).
OWNER_PANEL_SECRET=

# ---------------------------------------------------------------------------
# Coming soon gate (Production vs Preview)
# ---------------------------------------------------------------------------
# COMING_SOON_ENABLED — when "true", visitors only see the countdown page.
#   Recommended Vercel setup:
#     • Production  → COMING_SOON_ENABLED=true
#     • Preview     → leave unset / false (full shop, accounts, owner panel)
#     • Development → leave unset / false for local work
#   Open the site for everyone: set Production to false and redeploy.
#   The countdown never auto-unlocks at zero.
COMING_SOON_ENABLED=false

# COMING_SOON_ENDS_AT — fixed countdown end as ISO 8601 with timezone.
#   Example: COMING_SOON_ENDS_AT=2026-11-03T12:00:00-04:00
COMING_SOON_ENDS_AT=

# COMING_SOON_PREVIEW_SECRET — unlock via POST form at /site-unlock only
#   (never as ?preview= in the URL). Sets an httpOnly derived cookie.
COMING_SOON_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Stripe
# Local and Preview: test keys only (sk_test_ / pk_test_ / test whsec_).
# Production: live keys only, and only after PAYMENTS_LIVE_ENABLED=true.
# A test key on Production does not open Checkout. A live key outside
# Production does not open Checkout. Do not commit real secrets.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret from the webhook endpoint that matches this environment.
# Production must use the live-mode endpoint secret, not the test one.
# Signature verification stays on. Do not put this value in source code.
STRIPE_WEBHOOK_SECRET=whsec_...

# Checkout always charges CAD. Adaptive Pricing is disabled on each session.

# Production live charges stay OFF unless this is true AND both keys are live
# AND STRIPE_WEBHOOK_SECRET is set. Leave false until that setup is complete.
PAYMENTS_LIVE_ENABLED=false

# MAIL_CLUB_CHECKOUT_ENABLED — Join/subscription checkout (test keys only when true)
MAIL_CLUB_CHECKOUT_ENABLED=false

# Checkout collects a shipping address and charges CA$0. No shipping fee.

# Stripe Tax — only when Tax is configured in the Dashboard
STRIPE_AUTOMATIC_TAX=false

# ---------------------------------------------------------------------------
# Mobile app push notifications (server only — never put these in the app)
# ---------------------------------------------------------------------------
# iOS (APNs token key from Apple Developer → Keys, with Apple Push Notifications enabled)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.thechocobananaclub.app
# "development" for builds installed from Xcode, "production" for TestFlight / App Store
APNS_ENVIRONMENT=production

# Android (Firebase console → Project settings → Service accounts → Generate new private key).
# Paste the JSON as one line or base64-encode it.
FCM_SERVICE_ACCOUNT_JSON=
